# Public Expo URL. For local tests, set to your running Worker address.
EXPO_PUBLIC_SITE_URL=https://perverseworld.com

# Set these as Worker secrets in Cloudflare, never as public variables.
# RESEND_API_KEY= (full-access key for sending and receiving)
# RESEND_WEBHOOK_SECRET= (signing secret for the email.received webhook)
# TURNSTILE_SECRET= (secret for the existing Turnstile widget)
# Notification recipient is configured as NOTIFICATION_EMAIL in wrangler.toml.
